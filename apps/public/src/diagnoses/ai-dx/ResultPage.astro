---
import type { AiDxDefinition, LevelContent } from "./types";
import LeadForm from "../../components/diagnosis/LeadForm.astro";
import NextSteps from "../../components/diagnosis/NextSteps.astro";
import { diagnosisQuestionsPath, diagnosisCrossPath, resolveCtas, type DiagnosisCta } from "../../lib/diagnosis/routes";
import { buildContactMessage } from "./contact-message";

interface Props {
  definition: AiDxDefinition;
  level: LevelContent;
}

const { definition, level } = Astro.props as Props;
const OTHER_SLUG = "business";
const levelName = `レベル${level.level}: ${level.name}`;

// Build-time hrefs carry the level only; result.js rewrites them once it knows the scores.
const ctaContext = { slug: definition.slug, otherSlug: OTHER_SLUG, contactMessage: buildContactMessage({ title: definition.title, version: definition.version, levelName }), resultUrl: null };
const [primaryCta] = resolveCtas([level.primaryCta], ctaContext);
const secondaryCtas = resolveCtas(level.secondaryCtas, ctaContext);
const shownKinds = new Set([level.primaryCta.kind, ...level.secondaryCtas.map((cta) => cta.kind)]);
const tailCandidates: DiagnosisCta[] = [
  { kind: "contact", label: "通常のお問い合わせ" },
  { kind: "line", label: "LINEで相談する" },
];
const tailCtas = resolveCtas(
  tailCandidates.filter((cta) => !shownKinds.has(cta.kind)),
  ctaContext,
);

const levelSteps = [1, 2, 3, 4, 5];
const sections = [
  { icon: "info", heading: "現在地の説明", body: level.current, iconBg: "bg-blue-500/10", iconColor: "text-blue-600" },
  { icon: "report", heading: "このレベルの落とし穴", body: level.pitfall, iconBg: "bg-amber-500/15", iconColor: "text-amber-600" },
  { icon: "warning", heading: "放置した場合のリスク", body: level.risk, iconBg: "bg-red-500/10", iconColor: "text-red-600" },
  { icon: "lightbulb", heading: "一般的な次の一手", body: level.nextStep, iconBg: "bg-natural-teal/10", iconColor: "text-natural-teal-dark" },
];
---

<main class="mx-auto max-w-2xl px-6 pt-10 pb-16">
  <div class="diagnosis-reveal relative mb-10 overflow-hidden rounded-3xl bg-natural-cream px-6 py-12 text-center">
    <div class="blob -top-10 -right-10 h-56 w-56 bg-natural-teal-light/50"></div>
    <div class="blob -bottom-16 -left-10 h-48 w-48 bg-natural-peach/60"></div>
    <div class="relative z-10">
      <div class="diagnosis-icon-lg mx-auto mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-white shadow-md">
        <span class="material-symbols-outlined text-natural-teal-dark">{level.icon}</span>
      </div>
      <p class="mb-2 font-poppins text-xs font-medium tracking-widest text-natural-muted uppercase">Diagnosis Result</p>
      <h1 class="mb-6 text-2xl leading-snug font-bold text-natural-text lg:text-3xl">
        あなたの会社は<br />【レベル{level.level}:{level.name}】の段階です
      </h1>

      <div class="flex items-center justify-center">
        {
          levelSteps.map((n) => (
            <>
              <div class={`flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full text-xs font-bold ${n <= level.level ? "bg-natural-teal text-white" : "bg-white text-natural-muted"}`}>{n}</div>
              {n < 5 && <div class={`h-0.5 w-4 sm:w-8 ${n < level.level ? "bg-natural-teal" : "bg-natural-gray"}`} />}
            </>
          ))
        }
      </div>

      <p id="diagnosis-reason" class="mx-auto mt-6 hidden max-w-md text-xs leading-relaxed text-natural-muted"></p>
      <p id="diagnosis-balance-note" class="mx-auto mt-3 hidden max-w-md rounded-xl bg-white/80 px-5 py-3 text-sm leading-relaxed text-natural-text shadow-sm"></p>
    </div>
  </div>

  <div id="diagnosis-axis-section" class="diagnosis-reveal mb-5 hidden rounded-2xl border border-natural-gray bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-base font-bold text-natural-text lg:text-lg">軸別スコア</h2>
    <div class="space-y-4">
      {
        definition.axes.map((axis, index) => (
          <div>
            <div class="mb-1 flex items-center justify-between text-sm">
              <span class="flex items-center gap-2 text-natural-text">
                {axis.name}
                <span id={`diagnosis-axis-badge-${index}`} class="hidden rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold text-emerald-700">
                  強み
                </span>
              </span>
              <span id={`diagnosis-axis-value-${index}`} class="text-xs text-natural-muted" />
            </div>
            <div class="diagnosis-progress-track h-3">
              <div id={`diagnosis-axis-fill-${index}`} class="diagnosis-progress-fill" style="width: 0%" />
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-6 rounded-xl bg-natural-cream p-5">
      <h3 id="diagnosis-weakest-heading" class="mb-2 text-sm font-bold text-natural-text"></h3>
      <p id="diagnosis-weakest-body" class="mb-2 text-sm leading-relaxed text-natural-text"></p>
      <p id="diagnosis-weakest-service" class="text-xs text-natural-muted"></p>
    </div>
  </div>

  <div class="space-y-5">
    {
      sections.map((section, index) => (
        <section class="diagnosis-reveal rounded-2xl border border-natural-gray bg-white p-6 shadow-sm" style={`animation-delay: ${80 + index * 80}ms`}>
          <div class="mb-3 flex items-center gap-2.5">
            <span class={`diagnosis-icon-sm flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full ${section.iconBg}`}>
              <span class={`material-symbols-outlined ${section.iconColor}`}>{section.icon}</span>
            </span>
            <h2 class="text-base font-bold text-natural-text lg:text-lg">{section.heading}</h2>
          </div>
          <p class="text-sm leading-relaxed text-natural-text lg:text-base">{section.body}</p>
        </section>
      ))
    }

    <section id="diagnosis-strengths" class="diagnosis-reveal hidden rounded-2xl border border-natural-gray bg-white p-6 shadow-sm" aria-labelledby="diagnosis-strengths-heading">
      <div class="mb-3 flex items-center gap-2.5">
        <span class="diagnosis-icon-sm flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
          <span class="material-symbols-outlined text-emerald-600">thumb_up</span>
        </span>
        <h2 id="diagnosis-strengths-heading" class="text-base font-bold text-natural-text lg:text-lg">強み</h2>
      </div>
      <ul id="diagnosis-strengths-list" class="space-y-2 text-sm leading-relaxed text-natural-text lg:text-base"></ul>
    </section>

    <section id="diagnosis-first-steps" class="diagnosis-reveal hidden rounded-2xl border border-natural-gray bg-white p-6 shadow-sm" aria-labelledby="diagnosis-first-steps-heading">
      <div class="mb-3 flex items-center gap-2.5">
        <span class="diagnosis-icon-sm flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-natural-peach/40">
          <span class="material-symbols-outlined text-natural-peach-dark">footprint</span>
        </span>
        <h2 id="diagnosis-first-steps-heading" class="text-base font-bold text-natural-text lg:text-lg">自社でできる最初の一歩</h2>
      </div>
      <ol id="diagnosis-first-steps-list" class="space-y-2 text-sm leading-relaxed text-natural-text lg:text-base"></ol>
    </section>

    <p class="diagnosis-reveal rounded-2xl bg-natural-cream px-6 py-5 text-sm leading-relaxed text-natural-text">
      {definition.limitationText}
    </p>

    <NextSteps primary={primaryCta} secondary={secondaryCtas} tail={tailCtas} />
    <LeadForm />
  </div>

  <div class="mt-8 flex flex-col items-center gap-4">
    <a href={diagnosisQuestionsPath(definition.slug)} class="text-sm text-natural-muted transition-colors hover:text-natural-teal">もう一度診断する</a>
  </div>

  <section id="diagnosis-cross" class="diagnosis-reveal mt-8 rounded-2xl border border-natural-gray bg-white p-5 text-center shadow-sm" aria-labelledby="diagnosis-cross-heading">
    <h2 id="diagnosis-cross-heading" class="sr-only">もう一方の診断</h2>
    <p class="mb-3 text-sm leading-relaxed text-natural-text">{definition.crossLinkLead}</p>
    <a href={diagnosisCrossPath(OTHER_SLUG, definition.slug)} data-cta-kind="cross_diagnosis" class="inline-flex items-center gap-1.5 text-sm font-medium text-natural-teal-dark transition-colors hover:text-natural-teal">
      {definition.crossLinkLabel}
      <span class="diagnosis-icon-sm inline-flex items-center">
        <span class="material-symbols-outlined">arrow_forward</span>
      </span>
    </a>
  </section>
</main>
