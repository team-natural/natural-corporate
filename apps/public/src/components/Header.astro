<!-- The drawer checkbox, overlay, and drawer nav must stay OUTSIDE <header>:
     .scrolled applies backdrop-filter to the header, which would turn it into
     the containing block for fixed descendants and clip the drawer. -->
<input type="checkbox" id="nav-drawer" class="peer hidden" />

<header id="site-header" class="fixed top-0 right-0 left-0 z-50 bg-transparent transition-[background-color,box-shadow] duration-400">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center">
      <img src="/assets/img/logo.svg" alt="株式会社ナチュラル" height="55" class="h-9 transition-all duration-300" id="header-logo" />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="グローバルナビゲーション">
      <a href="/about/" class="group relative text-sm font-medium text-natural-text transition-colors duration-200 hover:text-natural-teal">
        会社紹介
        <span class="absolute -bottom-1 left-0 h-0.5 w-0 rounded bg-natural-teal transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/development/" class="group relative text-sm font-medium text-natural-text transition-colors duration-200 hover:text-natural-teal">
        システム開発
        <span class="absolute -bottom-1 left-0 h-0.5 w-0 rounded bg-natural-teal transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/ai-dx/" class="group relative text-sm font-medium text-natural-text transition-colors duration-200 hover:text-natural-teal">
        AI・DX支援
        <span class="absolute -bottom-1 left-0 h-0.5 w-0 rounded bg-natural-teal transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/cases/" class="group relative text-sm font-medium text-natural-text transition-colors duration-200 hover:text-natural-teal">
        導入事例
        <span class="absolute -bottom-1 left-0 h-0.5 w-0 rounded bg-natural-teal transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/products/" class="group relative text-sm font-medium text-natural-text transition-colors duration-200 hover:text-natural-teal">
        自社サービス
        <span class="absolute -bottom-1 left-0 h-0.5 w-0 rounded bg-natural-teal transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/seminar/" class="group relative text-sm font-medium text-natural-text transition-colors duration-200 hover:text-natural-teal">
        セミナー
        <span class="absolute -bottom-1 left-0 h-0.5 w-0 rounded bg-natural-teal transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/news/" class="group relative text-sm font-medium text-natural-text transition-colors duration-200 hover:text-natural-teal">
        お知らせ
        <span class="absolute -bottom-1 left-0 h-0.5 w-0 rounded bg-natural-teal transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/contact/" class="rounded-full bg-natural-teal px-5 py-2.5 text-sm font-medium text-white shadow-md transition-all duration-300 hover:bg-natural-teal-dark hover:shadow-lg"> お問い合わせ </a>
    </nav>

    <button type="button" id="nav-toggle" class="z-50 flex cursor-pointer flex-col gap-1.5 p-2 md:hidden" aria-label="メニュー" aria-expanded="false" aria-controls="nav-menu">
      <span class="block h-0.5 w-6 rounded bg-natural-teal"></span>
      <span class="block h-0.5 w-6 rounded bg-natural-teal"></span>
      <span class="block h-0.5 w-6 rounded bg-natural-teal"></span>
    </button>
  </div>
</header>

<label for="nav-drawer" id="nav-overlay" class="pointer-events-none fixed inset-0 z-40 bg-black/40 opacity-0 transition-opacity duration-300 peer-checked:pointer-events-auto peer-checked:opacity-100"></label>

<nav id="nav-menu" aria-label="モバイルメニュー" inert class="fixed top-0 right-0 z-50 h-full w-72 translate-x-full bg-linear-160 from-natural-forest to-natural-forest-dark transition-transform duration-300 peer-checked:translate-x-0">
  <div class="p-8 pt-20">
    <img src="/assets/img/logo-white.svg" alt="ナチュラル" height="55" loading="lazy" class="mb-10 h-8" />
    <ul class="space-y-6">
      <li>
        <a href="/about/" class="font-medium tracking-wide text-white/90 hover:text-white">会社紹介</a>
      </li>
      <li>
        <a href="/development/" class="font-medium tracking-wide text-white/90 hover:text-white">システム開発</a>
      </li>
      <li>
        <a href="/ai-dx/" class="font-medium tracking-wide text-white/90 hover:text-white">AI・DX支援</a>
      </li>
      <li>
        <a href="/cases/" class="font-medium tracking-wide text-white/90 hover:text-white">導入事例</a>
      </li>
      <li>
        <a href="/products/" class="font-medium tracking-wide text-white/90 hover:text-white">自社サービス</a>
      </li>
      <li>
        <a href="/seminar/" class="font-medium tracking-wide text-white/90 hover:text-white">セミナー</a>
      </li>
      <li>
        <a href="/news/" class="font-medium tracking-wide text-white/90 hover:text-white">お知らせ</a>
      </li>
      <li>
        <a href="/contact/" class="inline-block rounded-full border border-white/60 px-6 py-2.5 text-sm text-white transition-all duration-300 hover:bg-white hover:text-natural-teal-dark"> お問い合わせ </a>
      </li>
    </ul>
    <div class="mt-12 text-xs text-white/70">© 2026 株式会社ナチュラル</div>
  </div>
</nav>
