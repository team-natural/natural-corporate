<section class="relative overflow-hidden bg-linear-135 from-natural-teal-dark via-natural-teal to-natural-teal-light px-6 py-14 before:absolute before:-top-[60%] before:-right-[10%] before:h-[500px] before:w-[500px] before:rounded-full before:bg-white/[0.06] before:content-[''] after:absolute after:-bottom-[40%] after:-left-[5%] after:h-[360px] after:w-[360px] after:rounded-full after:bg-white/[0.04] after:content-['']">
