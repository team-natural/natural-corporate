---
import DiagnosisLayout from "../../../../layouts/DiagnosisLayout.astro";
import ResultPage from "../../../../diagnoses/business/ResultPage.astro";
import business from "../../../../diagnoses/business/data";
import { diagnosisResultPath } from "../../../../lib/diagnosis/routes";

// output: "server" (astro.config.mjs) server-renders every page by default, and getStaticPaths()
// is silently ignored without this — every result URL would render with no result type at all.
export const prerender = true;

export async function getStaticPaths() {
  return business.resultTypes.map((resultType) => ({
    params: { type: resultType.id.toLowerCase() },
    props: { resultType },
  }));
}

const definition = business;
const { resultType } = Astro.props;
const title = `あなたの会社は【${resultType.name}】です`;
const path = diagnosisResultPath(definition.slug, resultType.id);

const scoreTypes = definition.resultTypes.filter((rt) => rt.id !== definition.zeroScoreTypeId);
const resultData = {
  slug: definition.slug,
  currentTypeId: resultType.id.toLowerCase(),
  bridgeTextByConcern: definition.bridgeTextByConcern,
  secondaryNames: Object.fromEntries(definition.resultTypes.map((rt) => [rt.id.toLowerCase(), rt.name])),
  scoreTypeCount: scoreTypes.length,
  scoreTypeIds: scoreTypes.map((rt) => rt.id.toLowerCase()),
  chartLabels: scoreTypes.map((rt) => rt.chartLabel),
};
const resultDataJson = JSON.stringify(resultData).replace(/</g, "\\u003c");
---

<DiagnosisLayout title={title} description={resultType.description} path={path} variant="result">
  <ResultPage definition={definition} resultType={resultType} />

  <script type="application/json" id="diagnosis-result-data" set:html={resultDataJson} />
  <script src="../../../../diagnoses/business/result.js"></script>
</DiagnosisLayout>
