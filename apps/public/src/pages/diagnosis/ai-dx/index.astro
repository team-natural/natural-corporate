---
import DiagnosisLayout from "../../../layouts/DiagnosisLayout.astro";
import aiDx from "../../../diagnoses/ai-dx/data";
import { diagnosisIntroPath, diagnosisQuestionsPath } from "../../../lib/diagnosis/routes";

export const prerender = true;

const definition = aiDx;
---

<DiagnosisLayout title={definition.title} description={definition.metaDescription} path={diagnosisIntroPath(definition.slug)} variant="intro">
  <main class="mx-auto flex min-h-[70vh] max-w-2xl flex-col justify-center px-6 py-16 text-center">
    <div class="mb-4 flex items-center justify-center gap-3">
      <img src="/assets/img/dot.png" alt="" width="42" height="42" loading="lazy" class="h-5 w-5" />
      <span class="font-poppins text-sm tracking-widest text-natural-muted uppercase">Diagnosis</span>
    </div>
    <h1 class="mb-6 text-2xl leading-snug font-bold text-natural-text lg:text-3xl" set:html={definition.catchCopy} />
    <p class="mb-4 text-sm leading-relaxed text-natural-text lg:text-base">{definition.subCopy}</p>
    <a href={diagnosisQuestionsPath(definition.slug)} class="mx-auto mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-natural-teal px-10 py-4 text-base font-medium text-white shadow-md transition-all duration-300 hover:bg-natural-teal-dark hover:shadow-lg">
      {definition.startButtonLabel}
    </a>
  </main>
</DiagnosisLayout>
