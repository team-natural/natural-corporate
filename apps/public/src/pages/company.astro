---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout title="会社概要" description="株式会社ナチュラルの会社概要をご紹介します。基本情報・拠点・ISMS認証（ISO 27001:2022）についてはこちらをご覧ください。" path="/company/">
  <!-- ===== PAGE HERO ===== -->
  <section class="relative overflow-hidden bg-natural-cream pt-36 pb-14">
    <div class="blob -top-16 -right-16 h-72 w-72 bg-natural-teal-light/50"></div>
    <div class="blob -bottom-16 -left-16 h-72 w-72 bg-natural-peach-mid/60"></div>
    <div class="absolute right-24 bottom-6 h-24 w-24 overflow-hidden rounded-full dot-pattern opacity-30"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-6">
      <div class="mb-4 flex items-center gap-3">
        <img src="/assets/img/dot.png" alt="" width="42" height="42" loading="lazy" class="h-5 w-5" />
        <span class="font-poppins text-sm tracking-widest text-natural-muted uppercase">Company</span>
      </div>
      <h1 class="text-3xl font-bold text-natural-text lg:text-4xl">会社概要</h1>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-natural-muted">株式会社ナチュラルの会社概要をご紹介します。基本情報・拠点・ISMS認証（ISO 27001:2022）についてはこちらをご覧ください。</p>
      <nav class="mt-4 text-xs text-natural-muted"><a href="/" class="transition-colors hover:text-natural-teal">ホーム</a> / 会社概要</nav>
    </div>
  </section>

  <!-- ===== COMPANY OVERVIEW table ===== -->
  <section id="overview" class="relative scroll-mt-24 overflow-hidden bg-white py-24">
    <div class="blob top-10 -left-20 h-80 w-80 bg-natural-cream"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-6" data-aos="fade-up" data-aos-duration="800">
      <div class="mb-10 flex items-center gap-3">
        <img src="/assets/img/dot.png" alt="" width="42" height="42" loading="lazy" class="h-5 w-5" />
        <h2 class="text-2xl font-bold text-natural-text lg:text-3xl">基本情報</h2>
      </div>

      <dl class="divide-y divide-natural-gray rounded-2xl bg-white text-sm shadow-lg ring-1 ring-natural-teal/10 lg:text-base">
        <div class="flex flex-col gap-1 px-6 py-5 md:flex-row md:gap-6">
          <dt class="flex-shrink-0 font-medium text-natural-muted md:w-40">会社名</dt>
          <dd class="text-natural-text">株式会社ナチュラル（Natural, Inc.）</dd>
        </div>
        <div class="flex flex-col gap-1 px-6 py-5 md:flex-row md:gap-6">
          <dt class="flex-shrink-0 font-medium text-natural-muted md:w-40">設立</dt>
          <dd class="text-natural-text">2014年6月12日</dd>
        </div>
        <div class="flex flex-col gap-1 px-6 py-5 md:flex-row md:gap-6">
          <dt class="flex-shrink-0 font-medium text-natural-muted md:w-40">資本金</dt>
          <dd class="text-natural-text">990万円</dd>
        </div>
        <div class="flex flex-col gap-1 px-6 py-5 md:flex-row md:gap-6">
          <dt class="flex-shrink-0 font-medium text-natural-muted md:w-40">代表取締役</dt>
          <dd class="text-natural-text">藤本 翔太</dd>
        </div>
        <div class="flex flex-col gap-1 px-6 py-5 md:flex-row md:gap-6">
          <dt class="flex-shrink-0 font-medium text-natural-muted md:w-40">本社所在地</dt>
          <dd class="text-natural-text">〒983-0852 宮城県仙台市宮城野区榴岡1-1-1<br />JR仙台イーストゲートビル2F</dd>
        </div>
        <div class="flex flex-col gap-1 px-6 py-5 md:flex-row md:gap-6">
          <dt class="flex-shrink-0 font-medium text-natural-muted md:w-40">電話番号</dt>
          <dd class="text-natural-text">022-796-4279</dd>
        </div>
        <div class="flex flex-col gap-1 px-6 py-5 md:flex-row md:gap-6">
          <dt class="flex-shrink-0 font-medium text-natural-muted md:w-40">事業内容</dt>
          <dd class="text-natural-text">WEBサイト制作、WEBシステム開発、スマートフォンアプリ開発、3DCG制作、AI導入支援</dd>
        </div>
        <div class="flex flex-col gap-1 px-6 py-5 md:flex-row md:gap-6">
          <dt class="flex-shrink-0 font-medium text-natural-muted md:w-40">認証</dt>
          <dd class="text-natural-text">ISO 27001:2022（ISMS）</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ===== LOCATIONS ===== -->
  <section id="locations" class="relative scroll-mt-24 overflow-hidden bg-natural-gray py-24">
    <div class="blob -top-12 right-0 h-64 w-64 bg-natural-peach"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-6">
      <div class="mb-10 flex items-center gap-3" data-aos="fade-up">
        <img src="/assets/img/dot.png" alt="" width="42" height="42" loading="lazy" class="h-5 w-5" />
        <h2 class="text-2xl font-bold text-natural-text lg:text-3xl">拠点</h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl bg-white p-8 shadow-md" data-aos="fade-up" data-aos-delay="100">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-xl bg-linear-135 from-natural-teal-dark to-natural-teal">
            <i class="fas fa-building text-xl text-white"></i>
          </div>
          <h3 class="mb-3 text-lg font-bold text-natural-text">本社（仙台）</h3>
          <p class="mb-4 text-sm leading-relaxed text-natural-text">〒983-0852<br />宮城県仙台市宮城野区榴岡1-1-1<br />JR仙台イーストゲートビル2F</p>
          <ul class="space-y-2 text-xs text-natural-muted">
            <li class="flex items-center gap-2"><i class="fas fa-train text-natural-teal"></i>JR仙台駅より徒歩1分</li>
            <li class="flex items-center gap-2"><i class="fas fa-car text-natural-teal"></i>東北自動車道 仙台宮城ICより車で10分</li>
          </ul>
        </div>

        <div class="rounded-2xl bg-white p-8 shadow-md" data-aos="fade-up" data-aos-delay="200">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-xl bg-linear-135 from-natural-teal to-natural-teal-light">
            <i class="fas fa-earth-asia text-xl text-white"></i>
          </div>
          <h3 class="mb-3 text-lg font-bold text-natural-text">インドネシア開発拠点</h3>
          <p class="text-sm leading-relaxed text-natural-text">Yogyakarta, Indonesia</p>
          <p class="mt-4 text-xs leading-relaxed text-natural-muted">国際チームによる開発体制で、品質とコストを両立した開発を実現しています。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ISMS ===== -->
  <section id="isms" class="relative scroll-mt-24 overflow-hidden bg-white py-24">
    <div class="blob -right-16 bottom-0 h-72 w-72 bg-natural-teal-light/40"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-6" data-aos="fade-up" data-aos-duration="800">
      <div class="mb-10 flex items-center gap-3">
        <img src="/assets/img/dot.png" alt="" width="42" height="42" loading="lazy" class="h-5 w-5" />
        <h2 class="text-2xl font-bold text-natural-text lg:text-3xl">ISMS認証取得について</h2>
      </div>

      <div class="flex flex-col items-start gap-10 rounded-2xl bg-natural-gray p-8 md:flex-row md:items-center lg:p-10">
        <div class="mx-auto flex-shrink-0 rounded-xl bg-white px-4 py-5 shadow-md md:mx-0">
          <img src="/assets/img/isms.png" alt="ISMS認証（JCSR）" width="292" height="162" loading="lazy" class="h-24 object-contain" />
        </div>
        <dl class="w-full flex-1 space-y-3 text-sm">
          <div class="flex flex-col gap-1 md:flex-row md:gap-6">
            <dt class="flex-shrink-0 font-medium text-natural-muted md:w-24">認証規格</dt>
            <dd class="text-natural-text">ISO 27001:2022</dd>
          </div>
          <div class="flex flex-col gap-1 md:flex-row md:gap-6">
            <dt class="flex-shrink-0 font-medium text-natural-muted md:w-24">認証番号</dt>
            <dd class="text-natural-text">ISMS23001</dd>
          </div>
          <div class="flex flex-col gap-1 md:flex-row md:gap-6">
            <dt class="flex-shrink-0 font-medium text-natural-muted md:w-24">認定機関</dt>
            <dd class="text-natural-text">一般社団法人日本シーエスアール登録機構（JCSR）</dd>
          </div>
          <div class="flex flex-col gap-1 md:flex-row md:gap-6">
            <dt class="flex-shrink-0 font-medium text-natural-muted md:w-24">認証範囲</dt>
            <dd class="text-natural-text">ウェブアプリケーション開発、スマートフォンアプリケーション開発</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
