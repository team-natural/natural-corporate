---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。URLが変更または削除された可能性があります。" path="/404/" noindex>
  <!-- ===== 404 HERO ===== -->
  <section class="relative flex min-h-[70vh] items-center overflow-hidden bg-natural-cream pt-36 pb-24">
    <div class="blob -top-16 -right-16 h-72 w-72 bg-natural-teal-light/50"></div>
    <div class="blob -bottom-16 -left-16 h-72 w-72 bg-natural-peach-mid/60"></div>
    <div class="absolute right-24 bottom-6 h-24 w-24 overflow-hidden rounded-full dot-pattern opacity-30"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-6 text-center">
      <p class="font-poppins text-7xl font-bold tracking-widest text-natural-teal lg:text-8xl">404</p>
      <div class="mt-4 mb-6 flex items-center justify-center gap-3">
        <img src="/assets/img/dot.png" alt="" width="42" height="42" loading="lazy" class="h-5 w-5" />
        <span class="font-poppins text-sm tracking-widest text-natural-muted uppercase">Not Found</span>
      </div>
      <h1 class="text-2xl font-bold text-natural-text lg:text-3xl">ページが見つかりません</h1>
      <p class="mx-auto mt-6 max-w-xl text-sm leading-relaxed text-natural-muted lg:text-base">お探しのページは、URLが変更・削除されたか、アドレスが間違っている可能性があります。<br />お手数ですが、トップページまたはサイトマップからお探しください。</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/" class="btn-more">
          <span>トップページへ戻る</span>
          <span class="btn-more-arrow"><i class="fas fa-arrow-right text-xs text-white"></i></span>
        </a>
        <a href="/sitemap/" class="btn-more btn-more-peach">
          <span>サイトマップを見る</span>
          <span class="btn-more-arrow"><i class="fas fa-arrow-right text-xs text-white"></i></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
